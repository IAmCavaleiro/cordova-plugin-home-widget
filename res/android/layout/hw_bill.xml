<?xml version="1.0" encoding="utf-8"?>
<!-- Layout B: caption, big amount, due line, pay button. Only RemoteViews-safe views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/hw_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hw_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/hw_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hw_text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hw_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hw_accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/hw_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/hw_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/hw_button"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/hw_button_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/hw_pill" />

        <TextView
            android:id="@+id/hw_button_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
